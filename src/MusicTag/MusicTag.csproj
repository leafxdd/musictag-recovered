<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MusicTag</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <!-- EXPERIMENTAL (branch experiment/per-monitor-dpi-v2): net481 -> net8.0-windows。
         动机:FW 4.8 的 WinForms DPI 代码自 2019 年冻结,副屏首显刻度错误与显式字体不随
         WM_DPICHANGED 缩放属框架缺陷(两轮实测均无法在 4.8 上修复),.NET 8 已系统性修复。
         回退 = 还原本文件与 MusicTag.Tests.csproj,并按各文件 "net8 迁移" 注释恢复代码。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- net8:x64 硬约束与同版本官方 SQLite.Interop.dll(x64 原生库)配套。 -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- net8:BinaryFormatter 默认禁用(net9 起整体移除)。ChineseTextConverter 反序列化内嵌
         简繁字库资源 MappingChars(tsmap/tcmap,构建期内嵌、非用户输入)仍依赖它,显式启用。
         resx 内的位图/图标资源同样经 BinaryFormatter(MSB3825),属同一知情决定,压掉逐条警告。 -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
    <AppConfig>musictag\MusicTag.exe.config</AppConfig>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <!-- CS0649 only: these fields ARE assigned at runtime where the compiler can't
         see it - P/Invoke Marshal.PtrToStructure (NativeNotificationHeader,
         NativePictureEntry, ThumbButton), BinaryFormatter deserialization
         (MappingChars), and the WinForms designer (components). CS0162/CS0414 were
         dropped after the dead-code cleanup left zero unreachable/unused-field warnings. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <!-- 应用图标单一来源:exe 内嵌图标与运行时 Resources.AppIcon 共用此文件
         (原 resx 里的 BinaryFormatter Icon 副本已移除)。 -->
    <EmbeddedResource Include="app.ico" LogicalName="MusicTag.AppIcon.ico" />
  </ItemGroup>
  <ItemGroup />
  <ItemGroup>
    <!-- net8:Fkosoft.FontAwesome4(netfx 程序集,原样引用)在构造时加载
         System.Runtime.Caching 4.0.0.0(netfx BCL,net8 共享框架无)。此兼容包的程序集版本
         特意保持 4.0.0.0,netfx 引用可直接绑定;缺它则启动即崩(FileNotFoundException)。 -->
    <PackageReference Include="System.Runtime.Caching" Version="8.0.1" />
    <!-- JPEG/PNG 统一解码、缩放与编码；AUTO 无需处理时仍保留 provider 原始字节。 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- net8:framework References(System.Xml/Configuration/Core/Numerics/Net.Http/Data)由
         共享框架隐式提供;System.Web(HttpUtility 在 core 内置)、System.Net.Http.WebRequest
         (WebRequestHandler 已改 HttpClientHandler)、Microsoft.VisualBasic(源码零使用的
         反编译残留引用)一并移除。以下本地 DLL 均为 netfx 构建,先原样引用试运行,
         加载失败再逐个换 nupkg 内 netstandard 构建。 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>musictag/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="TagLibSharp">
      <HintPath>musictag/TagLibSharp.dll</HintPath>
    </Reference>
    <Reference Include="UtfUnknown">
      <HintPath>musictag/UtfUnknown.dll</HintPath>
    </Reference>
    <Reference Include="Fkosoft.FontAwesome4">
      <HintPath>musictag/Fkosoft.FontAwesome4.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>musictag/System.Data.SQLite.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="musictag\MusicTag.config" Link="MusicTag.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.dat" Link="MusicTag.dat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.db" Link="MusicTag.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\SQLite.Interop.dll" Link="SQLite.Interop.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\UtfUnknown.dll" Link="UtfUnknown.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\en\MusicTag.resources.dll" Link="en\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\font\fontawesome-webfont.ttf" Link="font\fontawesome-webfont.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\zh-CHS\MusicTag.resources.dll" Link="zh-CHS\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\zh-CHT\MusicTag.resources.dll" Link="zh-CHT\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
