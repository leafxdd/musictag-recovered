<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>MusicTag</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net481</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
    <AppConfig>musictag\MusicTag.exe.config</AppConfig>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <!-- CS0649 only: these fields ARE assigned at runtime where the compiler can't
         see it - P/Invoke Marshal.PtrToStructure (NativeNotificationHeader,
         NativePictureEntry, ThumbButton), BinaryFormatter deserialization
         (MappingChars), and the WinForms designer (components). CS0162/CS0414 were
         dropped after the dead-code cleanup left zero unreachable/unused-field warnings. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup />
  <ItemGroup>
    <Reference Include="System.Xml" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>musictag/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Fkosoft.FontAwesome4">
      <HintPath>musictag/Fkosoft.FontAwesome4.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Data.SQLite">
      <HintPath>musictag/System.Data.SQLite.dll</HintPath>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http.WebRequest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="musictag\MediaInfo.dll" Link="MediaInfo.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.config" Link="MusicTag.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.dat" Link="MusicTag.dat" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.db" Link="MusicTag.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\MusicTag.dll" Link="MusicTag.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\SQLite.Interop.dll" Link="SQLite.Interop.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\en\MusicTag.resources.dll" Link="en\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\font\fontawesome-webfont.ttf" Link="font\fontawesome-webfont.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\zh-CHS\MusicTag.resources.dll" Link="zh-CHS\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="musictag\zh-CHT\MusicTag.resources.dll" Link="zh-CHT\MusicTag.resources.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
