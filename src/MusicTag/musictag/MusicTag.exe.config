<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
    <runtime>
      <legacyCorruptedStateExceptionsPolicy enabled="true"/>
    </runtime>
    <!-- EXPERIMENTAL: the .NET 4.6-era appSettings key EnableWindowsFormsHighDpiAutoResizing=true
         was removed on this branch — with the 4.7+ ApplicationConfigurationSection below present it
         is superseded (and stacking the legacy resize pass on PMv2 is a plausible double-scaling
         source). Restore that key under <appSettings> to revert. -->
    <!-- EXPERIMENTAL (branch experiment/per-monitor-dpi-v2): net8 迁移后,netfx-only 的
         System.Windows.Forms.ApplicationConfigurationSection(DpiAwareness=PerMonitorV2)已移除——
         .NET 8 忽略该机制,且未在 configSections 声明的节可能让 core 版 ConfigurationManager 报错。
         PMv2 现仅由 app.manifest 声明;startup/runtime 节 core 会忽略,保留以便回退 netfx。 -->
</configuration>
