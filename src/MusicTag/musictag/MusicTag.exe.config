<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1"/>
    </startup>
    <runtime>
      <legacyCorruptedStateExceptionsPolicy enabled="true"/>
    </runtime>
    <!-- EXPERIMENTAL: the .NET 4.6-era appSettings key EnableWindowsFormsHighDpiAutoResizing=true
         was removed on this branch — with the 4.7+ ApplicationConfigurationSection below present it
         is superseded (and stacking the legacy resize pass on PMv2 is a plausible double-scaling
         source). Restore that key under <appSettings> to revert. -->
    <!-- EXPERIMENTAL (branch experiment/per-monitor-dpi-v2 only): opt WinForms into Per-Monitor
         V2. Pairs with app.manifest dpiAwareness=PerMonitorV2 — see that manifest comment for the
         unverified-risk notes (startup-once custom ScaleByDpi vs. per-monitor auto-resize). Remove
         this section to revert. -->
    <System.Windows.Forms.ApplicationConfigurationSection>
      <add key="DpiAwareness" value="PerMonitorV2"/>
    </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
